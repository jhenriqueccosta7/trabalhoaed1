# M05 — carregado automaticamente pelo Makefile principal ou isoladamente.
M05_CC := gcc
M05_CFLAGS := -std=c11 -Wall -Wextra -Wpedantic -g -Iinclude
TESTES_MISSOES += test_m05
.PHONY: test_m05
build/test_m05_incremental: missoes/M05/test_m05.c src/lse.c include/lse.h
	@mkdir -p build
	$(M05_CC) $(M05_CFLAGS) missoes/M05/test_m05.c src/lse.c -o $@
test_m05: build/test_m05_incremental
	./build/test_m05_incremental
